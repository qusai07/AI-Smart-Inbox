# Copy to .env (git-ignored). Everything is optional — the defaults are free and need no keys.

# Analysis engine: Rules | Ollama | Claude | Hybrid (default: rules first, LLM only when unsure)
# AI_PROVIDER=Hybrid
# AI_LLM=Ollama

# Local LLM via Ollama running on the host (https://ollama.com): ollama pull qwen2.5:3b
# OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen2.5:3b

# Only if you choose Claude
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-5-5

# Routing emails. Default: the bundled smtp4dev test server (view mail at http://localhost:5100).
# Real server example (Office 365): SMTP_HOST=smtp.office365.com SMTP_PORT=587 SMTP_SECURITY=StartTls
# EMAIL_ENABLED=true
# SMTP_HOST=smtp4dev
# SMTP_PORT=25
# SMTP_SECURITY=None
# SMTP_USERNAME=
# SMTP_PASSWORD=
# EMAIL_FROM=smart-inbox@mds.demo
# APP_BASE_URL=http://localhost:8080

# Sign-in. Demo users are on by default (password Demo#2026). For real use:
# AUTH_SEED_DEMO=false
# AUTH_ADMIN_EMAIL=you@example.com
# AUTH_ADMIN_PASSWORD=a-long-unique-password

# "Sign in with Microsoft" (Entra ID app registration; redirect URI: <APP_BASE_URL>/signin-oidc)
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=

# SQL_PASSWORD=Your_strong_Passw0rd

# Webhooks. The compose demo allows http:// and internal receivers (webhook-receiver); set both to false
# when your receivers are on the internet.
# WEBHOOKS_ALLOW_HTTP=true
# WEBHOOKS_ALLOW_PRIVATE=true
# Signing secret of the endpoint you created for the demo receiver (docker compose --profile webhooks up)
# WEBHOOK_SECRET=whsec_...

# MCP server (docker compose --profile mcp up): allow Claude to route/close, not just read
# MCP_WRITES=false

# Shared mailbox: Smart Inbox imports new emails and their letters (IMAP, off by default).
# Real mailbox: MAILBOX_HOST=imap.gmail.com, MAILBOX_USERNAME=..., MAILBOX_PASSWORD=<app password>
# Demo with the bundled test server (docker compose --profile mailbox up):
# MAILBOX_ENABLED=true
# MAILBOX_HOST=greenmail
# MAILBOX_PORT=3143
# MAILBOX_SECURITY=None
# MAILBOX_USERNAME=correspondence@mds.demo
# MAILBOX_PASSWORD=demo
